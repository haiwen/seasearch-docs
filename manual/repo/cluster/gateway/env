COMPOSE_FILE='cluster-gateway.yml'
COMPOSE_PATH_SEPARATOR=','

SEASEARCH_CLUSTER_GATEWAY_IMAGE=seafileltd/seasearch-cluster-gateway:1.0-latest

# ETCD (required)
SS_ETCD_ENDPOINTS= # separated by commas, e.g., '192.168.0.1:2380,192.168.0.2:2380,192.168.0.3:2380'
SS_ETCD_USERNAME=
SS_ETCD_PASSWORD=
SS_ETCD_PREFIX=/seasearch

# Log
SS_CLUSTER_MANAGER_LOG_LEVEL=INFO
SS_CLUSTER_PROXY_LOG_LEVEL=INFO

# Gateway cluster (as required)
SS_GATEWAY_NODE_TYPE=
SS_CLUSTER_MANAGER_URL=
