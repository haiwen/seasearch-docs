COMPOSE_FILE='seasearch.yml'
COMPOSE_PATH_SEPARATOR=','

SEASEARCH_IMAGE=seafileltd/seasearch:1.0-latest

## local cache size limit
SS_MAX_OBJ_CACHE_SIZE=10GB

## s3 mode (required)
S3_SS_BUCKET=
S3_HOST=
S3_KEY_ID=
S3_SECRET_KEY=
S3_USE_HTTPS=true
S3_USE_V4_SIGNATURE=false
S3_PATH_STYLE_REQUEST=false
S3_AWS_REGION=us-east-1
S3_SSE_C_KEY=

# initial (required in first-time deployment)
INIT_SS_ADMIN_USER=
INIT_SS_ADMIN_PASSWORD=

# cluster (required)
SS_CLUSTER_ID= # node ID, e.g., 0, 1, 2..., (cannot modify after deployment)

## ETCD (required)
SS_ETCD_ENDPOINTS= # separated by commas, e.g., '192.168.0.1:2380,192.168.0.2:2380,192.168.0.3:2380'
SS_ETCD_USERNAME=
SS_ETCD_PASSWORD=
SS_ETCD_PREFIX=/seasearch

# log
SS_LOG_OUTPUT=true
SS_LOG_LEVEL=info
